{
  "$meta": {
    "name": "Cesium Design System",
    "version": "1.0.0",
    "description": "Dark-first design tokens for planetary-scale interfaces. Colors are theme-paired; static tokens are emitted once.",
    "generated": "tokens/tokens.json -> src/styles/tokens.css"
  },

  "color": {
    "bg-base":        { "dark": "#090A0E", "light": "#F4F5F7" },
    "bg-canvas":      { "dark": "#0D0F14", "light": "#F9FAFB" },
    "bg-surface":     { "dark": "#13161F", "light": "#FFFFFF" },
    "bg-raised":      { "dark": "#1A1E29", "light": "#FFFFFF" },
    "bg-inset":       { "dark": "#07080B", "light": "#EEF0F3" },
    "bg-hover":       { "dark": "rgba(255,255,255,0.06)", "light": "rgba(12,13,15,0.045)" },
    "bg-active":      { "dark": "rgba(255,255,255,0.095)", "light": "rgba(12,13,15,0.08)" },
    "bg-selected":    { "dark": "rgba(78,184,222,0.13)", "light": "rgba(31,108,135,0.08)" },

    "border-subtle":  { "dark": "rgba(255,255,255,0.08)", "light": "rgba(12,13,15,0.08)" },
    "border":         { "dark": "rgba(255,255,255,0.14)", "light": "rgba(12,13,15,0.14)" },
    "border-strong":  { "dark": "rgba(255,255,255,0.26)", "light": "rgba(12,13,15,0.26)" },

    "text-primary":   { "dark": "#F8F9FA", "light": "#0D0E11" },
    "text-secondary": { "dark": "#A6ABB3", "light": "#545960" },
    "text-tertiary":  { "dark": "#7E848D", "light": "#6D727B" },
    "text-disabled":  { "dark": "#4B5057", "light": "#A4A8AE" },
    "text-inverse":   { "dark": "#090A0E", "light": "#FFFFFF" },

    "solid":          { "dark": "#F8F9FA", "light": "#111317" },
    "solid-hover":    { "dark": "#FFFFFF", "light": "#000000" },
    "solid-active":   { "dark": "#D6D9DD", "light": "#26282E" },
    "solid-contrast": { "dark": "#090A0E", "light": "#FFFFFF" },

    "accent":         { "dark": "#4EB8DE", "light": "#1F6C87" },
    "accent-hover":   { "dark": "#6EC7EA", "light": "#17576E" },
    "accent-active":  { "dark": "#3EA0C4", "light": "#124355" },
    "accent-contrast":{ "dark": "#041217", "light": "#FFFFFF" },
    "accent-soft":    { "dark": "rgba(78,184,222,0.14)", "light": "rgba(31,108,135,0.09)" },
    "accent-line":    { "dark": "rgba(78,184,222,0.38)", "light": "rgba(31,108,135,0.34)" },

    "success":        { "dark": "#34D399", "light": "#0E8A5E" },
    "success-soft":   { "dark": "rgba(52,211,153,0.14)", "light": "rgba(14,138,94,0.10)" },
    "warning":        { "dark": "#FBBF24", "light": "#B46A08" },
    "warning-soft":   { "dark": "rgba(251,191,36,0.14)", "light": "rgba(180,106,8,0.10)" },
    "danger":         { "dark": "#F87171", "light": "#C53046" },
    "danger-soft":    { "dark": "rgba(248,113,113,0.14)", "light": "rgba(197,48,70,0.10)" },
    "danger-contrast":{ "dark": "#1B0409", "light": "#FFFFFF" },
    "info":           { "dark": "#60A5FA", "light": "#2563EB" },
    "info-soft":      { "dark": "rgba(96,165,250,0.14)", "light": "rgba(37,99,235,0.10)" },

    "grid-line":      { "dark": "rgba(255,255,255,0.04)", "light": "rgba(12,13,15,0.04)" },
    "grid-line-strong": { "dark": "rgba(255,255,255,0.08)", "light": "rgba(12,13,15,0.08)" },
    "overlay":        { "dark": "rgba(4,5,7,0.76)", "light": "rgba(12,13,15,0.42)" },
    "shadow-color":   { "dark": "0,0,0", "light": "12,13,15" }
  },

  "static": {
    "font-sans": "\"Instrument Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "font-mono": "\"JetBrains Mono\", \"SF Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "font-display": "\"Newsreader\", \"Newsreader Variable\", \"Iowan Old Style\", Georgia, \"Songti SC\", \"Times New Roman\", serif",

    "fs-2xs": "10px",
    "fs-xs": "11px",
    "fs-sm": "12px",
    "fs-base": "13px",
    "fs-md": "14px",
    "fs-lg": "16px",
    "fs-xl": "18px",
    "fs-2xl": "22px",
