    "atmos-900": "#103E52",
    "atmos-950": "#0A2836",

    "slate-50": "#F8F9FA",
    "slate-100": "#ECEEF0",
    "slate-200": "#D6D9DE",
    "slate-300": "#B3B8C1",
    "slate-400": "#8D939F",
    "slate-500": "#6A717E",
    "slate-600": "#4E545F",
    "slate-700": "#393E48",
    "slate-800": "#242831",
    "slate-900": "#151820",
    "slate-950": "#0D0F14",

    "signal-mint": "#34D399",
    "signal-amber": "#FBBF24",
    "signal-rose": "#F87171",
    "signal-iris": "#60A5FA",
    "signal-teal": "#2DD4BF"
