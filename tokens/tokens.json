    "lh-2xl": "30px",
    "lh-3xl": "36px",
    "lh-4xl": "42px",
    "lh-5xl": "54px",
    "lh-6xl": "68px",

    "fw-regular": "400",
    "fw-medium": "500",
    "fw-semibold": "600",
    "fw-bold": "700",

    "tracking-display": "-0.021em",
    "tracking-tight": "-0.014em",
    "tracking-snug": "-0.007em",
    "tracking-normal": "0em",
    "tracking-wide": "0.02em",
    "tracking-wider": "0.08em",
    "tracking-widest": "0.14em",

    "space-2": "2px",
    "space-4": "4px",
    "space-6": "6px",
    "space-8": "8px",
    "space-10": "10px",
    "space-12": "12px",
    "space-16": "16px",
    "space-20": "20px",
    "space-24": "24px",
    "space-32": "32px",
    "space-40": "40px",
    "space-48": "48px",
    "space-64": "64px",
    "space-80": "80px",
    "space-96": "96px",
    "space-128": "128px",

    "radius-xs": "3px",
    "radius-sm": "4px",
    "radius-md": "6px",
    "radius-lg": "10px",
    "radius-xl": "14px",
    "radius-2xl": "18px",
    "radius-pill": "999px",
    "radius-control": "6px",

    "dur-instant": "80ms",
    "dur-fast": "120ms",
    "dur-base": "180ms",
    "dur-slow": "260ms",
    "dur-slower": "420ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
