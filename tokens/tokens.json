    "control-lg": "40px",
    "header-h": "56px",
    "sidebar-w": "252px",
    "content-max": "900px",

    "atmos-50": "#EDF5F8",
    "atmos-100": "#D6E9F0",
    "atmos-200": "#B4D6E2",
    "atmos-300": "#85C4DB",
