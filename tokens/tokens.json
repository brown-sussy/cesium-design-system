  "shadow": {
    "shadow-xs": {
      "dark": "0 1px 2px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08)",
      "light": "0 1px 2px rgba(12,13,15,0.05), inset 0 1px 0 rgba(255,255,255,0.9)"
    },
    "shadow-sm": {
      "dark": "0 2px 8px -2px rgba(0,0,0,0.5), 0 1px 3px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.09)",
      "light": "0 2px 6px -1px rgba(12,13,15,0.08), 0 1px 2px rgba(12,13,15,0.04), inset 0 1px 0 rgba(255,255,255,0.9)"
    },
    "shadow-md": {
      "dark": "0 12px 28px -6px rgba(0,0,0,0.65), 0 4px 12px -2px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1)",
      "light": "0 10px 28px -6px rgba(12,13,15,0.14), 0 2px 8px -2px rgba(12,13,15,0.06), inset 0 1px 0 rgba(255,255,255,0.9)"
    },
    "shadow-lg": {
      "dark": "0 28px 64px -14px rgba(0,0,0,0.8), 0 8px 24px -4px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.12)",
      "light": "0 24px 60px -12px rgba(12,13,15,0.2), 0 6px 18px -3px rgba(12,13,15,0.08), inset 0 1px 0 rgba(255,255,255,0.9)"
    },
    "shadow-inset": {
      "dark": "inset 0 1px 0 rgba(255,255,255,0.08)",
      "light": "inset 0 1px 0 rgba(255,255,255,0.95)"
    }
  },

  "style": {
    "$meta": {
      "default": "classic",
      "description": "Shape presets. 'classic' is the instrument look (sharp 2–16px corners). 'plus' swaps in continuous, Apple-style corners with softer, wider elevation. Activated with <html data-style=\"plus\">."
    },
    "plus": {
      "radius-xs": "6px",
      "radius-sm": "8px",
      "radius-md": "12px",
      "radius-lg": "18px",
      "radius-xl": "24px",
      "radius-2xl": "32px",
      "radius-control": "999px",
      "shadow-xs": {
        "dark": "0 1px 3px rgba(0,0,0,0.36), inset 0 1px 0 rgba(255,255,255,0.1)",
        "light": "0 1px 3px rgba(12,13,15,0.05), inset 0 1px 0 rgba(255,255,255,1)"
      },
      "shadow-sm": {
        "dark": "0 4px 16px -3px rgba(0,0,0,0.58), 0 2px 6px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.12)",
        "light": "0 4px 14px -3px rgba(12,13,15,0.10), 0 1px 3px rgba(12,13,15,0.04), inset 0 1px 0 rgba(255,255,255,1)"
      },
      "shadow-md": {
        "dark": "0 18px 48px -12px rgba(0,0,0,0.7), 0 6px 18px -3px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.14)",
        "light": "0 18px 44px -14px rgba(12,13,15,0.18), 0 4px 12px -2px rgba(12,13,15,0.06), inset 0 1px 0 rgba(255,255,255,1)"
      },
      "shadow-lg": {
        "dark": "0 44px 96px -24px rgba(0,0,0,0.85), 0 12px 36px -6px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.16)",
        "light": "0 40px 92px -24px rgba(12,13,15,0.24), 0 10px 28px -4px rgba(12,13,15,0.08), inset 0 1px 0 rgba(255,255,255,1)"
      },
      "shadow-inset": {
        "dark": "inset 0 1px 0 rgba(255,255,255,0.1)",
        "light": "inset 0 1px 0 rgba(255,255,255,1)"
      }
    }
  }
}
